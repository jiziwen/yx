# 本地示例；生产使用受控凭证系统，不要提交真实 .env。
APP_ENV=development
DATABASE_URL=sqlite:///./.data/yingxu.db
STORAGE_ROOT=./.data/objects
DEV_LOGIN_ENABLED=true
SESSION_SECRET=local-development-only-change-before-production
# development 模式只在首次本地初始化时使用以下密码，不覆盖已有账户。
ADMIN_PASSWORD=yingxu-dev-admin
ADMIN_AUTH_MODE=development
AUTH_STATE_BACKEND=memory
ADMIN_SESSION_TTL=3600
# 生产选择 ADMIN_AUTH_MODE=database、AUTH_STATE_BACKEND=redis，并通过 CLI 开通管理员。
ALLOWED_ORIGINS=["http://127.0.0.1:5273","http://127.0.0.1:5274"]
REDIS_URL=redis://127.0.0.1:6389/0
# CONFIG_FILE=/absolute/path/to/application.yaml
# LLM_API_KEY=
# IMAGE_API_KEY=
# AI302_API_KEY=
# 302.AI 默认未启用；在独立 CONFIG_FILE 中启用 ai302-image 并选择 routes.image。

# 仅隔离工程验收可启用；生产拒绝此开发向量夹具。
KNOWLEDGE_DEVELOPMENT_EMBEDDING=false
